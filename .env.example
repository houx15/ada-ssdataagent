# OpenAI-compatible model endpoint
SDTL_LLM_BASE_URL=http://localhost:39001/v1
SDTL_LLM_API_KEY=not-needed
SDTL_LLM_MODEL=glm-5.2

# Request concurrency
SDTL_LLM_CONCURRENCY=30
SDTL_JUDGE_CONCURRENCY=30

# Paid suites read this only when --provider openrouter is selected.
# Keep the real value in the untracked .env file on the experiment server.
OPENROUTER_API_KEY=
